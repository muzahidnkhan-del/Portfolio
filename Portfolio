      font-weight: bold;
     }

     .progress-bar{
      width: 100%;
      height: 20px;
      background: rgba(255,255,255,0.2);
      border-radius: 50px;
      overflow: hidden;
     }

     .progress{
      height: 100%;
      border-radius: 50px;
      text-align: center;
      line-height: 20px;
      color: white;
      font-size: 12px;
      font-weight: bold;
     }

     .html{
      width: 90%;
      background: linear-gradient(to right,#ff512f, #dd2476);
     }

     .css{
      width: 85%;
      background: linear-gradient(to right,#36d1dc,#5b86e5);
     }

     .js{
      width: 75%;
      background: linear-gradient(to right,#17971e,#ffd200);
     }

     .react{
      width: 75%;
      background: linear-gradient(to right, #00c6ff, #0072ff);
     }

     .node{
      width: 75%;
      background: linear-gradient(to right, #dd2476, #c4f000);
     }

     
   .projects{
    width: 80%;
    margin: 50px auto;
    text-align: center;
   }

   .projects h2{
    color: white;
    margin-bottom: 30px;
    font-size: 2rem;
   }

   .project-container{
    display: flex;
    justify-content: center;
    gap: 20px;
    flex-wrap: wrap;
   }

   .project-card{
    width: 280px;
    padding: 25px;
    border-radius: 20px;
    background: rgba(255, 255,255, 0.1);
    backdrop-filter: blur(15px);
    border: 1px solid rgba(255,255,255,0.2);
    box-shadow: 0 8px 32px rgba(0,0,0,0.3);
    transition: 0.3s ease;
  }


  .project-card:hover{
    transform: translateY(-10px);
  }

  .project-card h3{
    color: white;
    margin-bottom: 10px;

  }

  .project-card p{
    color: white;
    line-height: 1.6;
  }

  .project-card button{

           background: linear-gradient(to right,#cfcc1d,#06cc9a);
           color: wheat;
            width: 100%;
            padding: 15px;
            margin-top: 20px;
            border: none;
            border-radius: 10px;
            font-size: 18px;
            font-weight: bold;
            cursor: pointer;
            transition: 0.3s;
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.5);
        }

        button:hover{
            transform: translateY(-5px);
            background-color: rgb(12, 129, 238);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.7 );
        }

        button:active{
            transform: scale(0.95);
        }

    

  









     

    






  
